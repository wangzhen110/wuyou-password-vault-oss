@import '../../styles/theme.wxss';

.page {
  min-height: 100vh;
  background: var(--bg-page);
  box-sizing: border-box;
}

.form { padding: 30rpx; }

.form-card {
  background: var(--bg-card);
  border: 1rpx solid var(--border-color);
  border-radius: 20rpx;
  padding: 10rpx 30rpx;
}

.field {
  display: flex;
  align-items: center;
  padding: 30rpx 0;
  border-bottom: 1rpx solid var(--border-color);
}
.field:last-child { border-bottom: none; }
.field-label {
  font-size: 28rpx;
  color: var(--text-secondary);
  width: 120rpx;
  flex-shrink: 0;
}

/* 头像选择器：视觉层 + 隐形 button 触发层（chooseAvatar 必须用 button；全机型圆形一致） */
.avatar-picker {
  position: relative;
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  overflow: hidden;
  background: rgba(44, 208, 106, 0.15);
  border: 2rpx dashed rgba(44, 208, 106, 0.6);
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
}
.avatar-picker-img { width: 100%; height: 100%; }
.avatar-picker-text { font-size: 22rpx; color: #2CD06A; }
.avatar-picker-trigger {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  margin: 0;
  padding: 0;
  border: none;
  background: transparent;
  opacity: 0;
  z-index: 2;
}
.avatar-picker-trigger::after { border: none; }

.field-input {
  flex: 1;
  font-size: 30rpx;
  color: var(--text-primary);
}
.form-hint {
  display: block;
  margin-top: 24rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--text-muted, #808080);
}

.save-btn {
  display: block;
  width: 100%;
  margin: 60rpx 0 0;
  padding: 0;
  height: 92rpx;
  line-height: 92rpx;
  border-radius: 16rpx;
  background: #2CD06A;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
}
.save-btn::after { border: none; }

/* 首次注册引导模式：跳过按钮（弱化样式） */
.skip-btn {
  margin-top: 20rpx;
  height: 80rpx;
  line-height: 80rpx;
  background: transparent;
  color: var(--text-secondary, #A0A0A0);
  font-size: 28rpx;
}
.skip-btn::after { border: none; }
