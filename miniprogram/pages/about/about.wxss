.page {
  min-height: 100vh;
  background: var(--bg-page);
  padding: 32rpx 28rpx 60rpx;
  box-sizing: border-box;
}

/* 品牌头 */
.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0 44rpx;
}
.hero-logo {
  width: 128rpx;
  height: 128rpx;
  border-radius: 30rpx;
  box-shadow: 0 12rpx 32rpx rgba(23, 194, 111, 0.28);
  margin-bottom: 24rpx;
}
.hero-name {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-primary);
  letter-spacing: 2rpx;
}
.hero-slogan {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: var(--text-muted);
}

/* 卡片 */
.card {
  background: var(--bg-card);
  border-radius: 24rpx;
  padding: 32rpx 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}
.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 20rpx;
}
.para {
  font-size: 27rpx;
  line-height: 1.85;
  color: var(--text-secondary);
  margin-bottom: 14rpx;
}
.para:last-child { margin-bottom: 0; }
.para.small { font-size: 25rpx; }
.strong {
  color: var(--text-primary);
  font-weight: 600;
}

/* 安全条目 */
.item {
  padding: 20rpx 0 20rpx 20rpx;
  border-left: 3rpx solid rgba(23, 194, 111, 0.45);
  margin-bottom: 6rpx;
}
.item + .item { margin-top: 4rpx; }
.item-body { flex: 1; }
.item-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 8rpx;
}
.item-desc {
  font-size: 25rpx;
  line-height: 1.8;
  color: var(--text-secondary);
}

/* 承诺 */
.promise {
  font-size: 26rpx;
  line-height: 1.9;
  color: var(--text-secondary);
}

/* 提醒卡（暖色） */
.card.warn {
  background: rgba(245, 166, 35, 0.08);
  border: 1rpx solid rgba(245, 166, 35, 0.25);
}
.card.warn .card-title { color: #b8791a; }
.card.warn .para { color: var(--text-secondary); }

/* 底部 */
.footer {
  text-align: center;
  padding: 30rpx 0 10rpx;
}
.footer-line {
  font-size: 24rpx;
  color: var(--text-muted);
}
.footer-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--text-muted);
  letter-spacing: 2rpx;
}

/* 金句（成本论述收尾） */
.item-desc.quote {
  margin-top: 14rpx;
  padding: 16rpx 18rpx;
  background: rgba(23, 194, 111, 0.07);
  border-radius: 10rpx;
}
