/* settings 设置页样式 V5.3 - 层次感+对齐 */
@import '../../styles/theme.wxss';

.page {
  background: var(--bg-page);
  min-height: 100vh;
}

.container {
  padding: 0 var(--sp-lg) calc(var(--sp-lg) + env(safe-area-inset-bottom));
  min-height: 100vh;
  background: var(--bg-page);
}

.status-bar-placeholder {
  height: 96rpx;
}

.page-header {
  padding: 88rpx 0 var(--sp-lg);
}

.page-title {
  font-size: var(--fs-xl);
  font-weight: 700;
  color: var(--nav-front);
}

/* 设置组卡片 - 加边框增加层次 */
.settings-group {
  background: var(--bg-card);
  border-radius: 20rpx;
  box-shadow: var(--shadow-card);
  margin-bottom: var(--sp-md);
  overflow: hidden;
  border: 1rpx solid var(--border-color);
}

.settings-item {
  display: flex;
  align-items: center;
  padding: 28rpx var(--sp-md);
  min-height: 96rpx;
  position: relative;
  gap: 24rpx;
}

.settings-divider {
  height: 1rpx;
  background: var(--border-color);
  margin-left: 92rpx;
}

.item-label {
  flex: 1;
  font-size: var(--fs-base);
  color: var(--text-primary);
}

.item-right {
  display: flex;
  align-items: center;
  gap: var(--sp-4);
}

.item-value {
  font-size: var(--fs-sm);
  color: var(--text-secondary);
}

/* 纯CSS箭头 */
.item-arrow {
  width: 12rpx;
  height: 12rpx;
  border-right: 2rpx solid var(--text-muted);
  border-bottom: 2rpx solid var(--text-muted);
  transform: rotate(-45deg);
  flex-shrink: 0;
}

/* ========== 图标系统 ========== */
.item-icon-wrap {
  width: 48rpx;
  height: 48rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

/* 字体大小 */
.item-icon-font { background: rgba(74,108,247,0.12); }
.icon-font-a {
  font-size: 24rpx;
  font-weight: 700;
  color: #5B7FFF;
  line-height: 1;
  font-family: serif;
}

/* 钥匙 */
.item-icon-key { background: rgba(245,158,11,0.12); }
.icon-key-shaft {
  width: 14rpx;
  height: 3rpx;
  background: var(--color-warning);
  border-radius: 2rpx;
  position: absolute;
  left: 15rpx;
}
.icon-key-head {
  width: 10rpx;
  height: 10rpx;
  border: 3rpx solid #F5A623;
  border-radius: 50%;
  position: absolute;
  right: 13rpx;
}

/* 云备份 */
.item-icon-backup { background: rgba(7,193,96,0.12); }
.icon-cloud {
  width: 24rpx;
  height: 14rpx;
  background: var(--color-primary);
  border-radius: 10rpx;
  position: relative;
}
.icon-cloud::before {
  content: '';
  position: absolute;
  top: -6rpx;
  left: 4rpx;
  width: 10rpx;
  height: 10rpx;
  background: var(--color-primary);
  border-radius: 50%;
}
.icon-cloud::after {
  content: '';
  position: absolute;
  top: -4rpx;
  right: 4rpx;
  width: 7rpx;
  height: 7rpx;
  background: var(--color-primary);
  border-radius: 50%;
}

/* 指纹 */
.item-icon-bio { background: rgba(124,58,237,0.12); }
.icon-fingerprint {
  width: 20rpx;
  height: 24rpx;
  border: 3rpx solid #9B6BFF;
  border-radius: 50% 50% 40% 40%;
}

/* 反馈 */
.item-icon-feedback { background: rgba(22,119,255,0.12); }
.icon-msg {
  width: 22rpx;
  height: 16rpx;
  border: 3rpx solid #4A9AFF;
  border-radius: 6rpx;
  position: relative;
}
.icon-msg::after {
  content: '';
  position: absolute;
  bottom: -6rpx;
  left: 6rpx;
  width: 0;
  height: 0;
  border-left: 4rpx solid transparent;
  border-right: 4rpx solid transparent;
  border-top: 6rpx solid #4A9AFF;
}

/* 客服 */
.item-icon-service { background: rgba(237,106,12,0.12); }
.icon-headset {
  width: 22rpx;
  height: 18rpx;
  border: 3rpx solid var(--color-warning);
  border-bottom: none;
  border-radius: 12rpx 12rpx 0 0;
  position: relative;
}
.icon-headset::after {
  content: '';
  position: absolute;
  bottom: -8rpx;
  left: -5rpx;
  width: 6rpx;
  height: 10rpx;
  background: var(--color-warning);
  border-radius: 0 0 3rpx 3rpx;
  box-shadow: 22rpx 0 0 0 #ED6A0C;
}

/* 关于 */
.item-icon-about { background: rgba(150,151,153,0.12); }
.icon-info {
  width: 20rpx;
  height: 20rpx;
  border: 3rpx solid #B0B0B0;
  border-radius: 50%;
  position: relative;
}
.icon-info::after {
  content: '';
  position: absolute;
  top: 4rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 3rpx;
  height: 8rpx;
  background: #B0B0B0;
  border-radius: 2rpx;
}

/* ========== 邀请卡片 ========== */
.invite-group {
  background: linear-gradient(135deg, var(--color-primary), var(--color-primary-dark));
  box-shadow: 0 8rpx 32rpx rgba(7,193,96,0.25);
  border: none;
}

.invite-header {
  padding: var(--sp-md) var(--sp-md) var(--sp-sm);
}

.invite-title {
  font-size: var(--fs-md);
  font-weight: 600;
  color: #FFFFFF;
  display: block;
  margin-bottom: var(--sp-2);
}

.invite-desc {
  font-size: var(--fs-sm);
  color: #FFFFFF;
  display: block;
  opacity: 0.9;
}

.invite-content {
  padding: var(--sp-sm) var(--sp-md) var(--sp-md);
}

.invite-code-row {
  display: flex;
  align-items: center;
  background: rgba(255,255,255,0.2);
  border-radius: var(--radius-sm);
  padding: var(--sp-sm) var(--sp-md);
  margin-bottom: var(--sp-sm);
  gap: var(--sp-sm);
}

.invite-label {
  font-size: var(--fs-sm);
  color: #FFFFFF;
  flex-shrink: 0;
}

.invite-code {
  flex: 1;
  font-size: var(--fs-base);
  font-weight: 600;
  color: #FFFFFF;
  letter-spacing: 4rpx;
}

.invite-copy-text {
  font-size: var(--fs-sm);
  color: #FFFFFF;
  background: rgba(255,255,255,0.25);
  padding: var(--sp-4) var(--sp-sm);
  border-radius: var(--radius-sm);
  font-weight: 500;
}

.invite-stats {
  margin-bottom: var(--sp-sm);
}

.invite-stat {
  font-size: var(--fs-sm);
  color: #FFFFFF;
}

.invite-btn {
  background: #FFFFFF;
  border-radius: var(--radius-full);
  padding: var(--sp-sm) var(--sp-lg);
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: var(--tap-min-size);
  border: none;
  line-height: 1.4;
}

.invite-btn::after { border: none; }

.invite-btn-text {
  color: var(--color-primary);
  font-size: var(--fs-base);
  font-weight: 600;
}

/* 反馈按钮覆盖 */
.feedback-wrap { position: relative; }
.feedback-btn {
  position: absolute;
  top: 0; left: 0;
  width: 100%; height: 100%;
  opacity: 0; padding: 0; margin: 0;
  border: none; background: transparent;
}

/* 版本号 */
.version-area {
  padding: var(--sp-xl) 0 calc(var(--sp-xl) + 120rpx);
  text-align: center;
}
.version-text {
  font-size: var(--fs-xs);
  color: var(--text-muted);
}
/* ========== 深色模式修复 ========== */
@media (prefers-color-scheme: dark) {
  /* 箭头颜色 - 深色模式下加亮 */
  .item-arrow {
    border-color: var(--text-secondary);
  }
  
  /* item-value 深色模式确保可见 */
  .item-value {
    color: var(--text-secondary);
  }
  
  /* 图标背景在深色模式下增加不透明度 */
  .item-icon-wrap {
    opacity: 1;
  }
  
  /* 图标内部元素在深色模式下保持颜色 */
  .icon-font-a { color: #7B9FFF; }
  .icon-fingerprint { border-color: #B08AFF; }
  .icon-msg { border-color: #6AB0FF; }
  .icon-msg::after { border-top-color: #6AB0FF; }
  .icon-headset { border-color: #FF8A3D; }
  .icon-headset::after { background: #FF8A3D; box-shadow: 22rpx 0 0 0 #FF8A3D; }
  .icon-info { border-color: #C0C0C0; }
  .icon-info::after { background: #C0C0C0; }
  .icon-key-head { border-color: #FFB74D; }
  .icon-key-shaft { background: #FFB74D; }
  .icon-cloud { background: #2CD06A; }
  .icon-cloud::before { background: #2CD06A; }
  .icon-cloud::after { background: #2CD06A; }
  
  /* 邀请卡片深色模式下按钮文字颜色适配 */
  .invite-btn-text {
    color: var(--color-primary);
  }
}

/* 强制深色主题 */
.page.theme-dark .item-arrow {
  border-color: var(--text-secondary);
}
.page.theme-dark .item-value {
  color: var(--text-secondary);
}
.page.theme-dark .icon-font-a { color: #7B9FFF; }
.page.theme-dark .icon-fingerprint { border-color: #B08AFF; }
.page.theme-dark .icon-msg { border-color: #6AB0FF; }
.page.theme-dark .icon-msg::after { border-top-color: #6AB0FF; }
.page.theme-dark .icon-headset { border-color: #FF8A3D; }
.page.theme-dark .icon-headset::after { background: #FF8A3D; box-shadow: 22rpx 0 0 0 #FF8A3D; }
.page.theme-dark .icon-info { border-color: #C0C0C0; }
.page.theme-dark .icon-info::after { background: #C0C0C0; }
.page.theme-dark .icon-key-head { border-color: #FFB74D; }
.page.theme-dark .icon-key-shaft { background: #FFB74D; }
.page.theme-dark .icon-cloud { background: #2CD06A; }
.page.theme-dark .icon-cloud::before { background: #2CD06A; }
.page.theme-dark .icon-cloud::after { background: #2CD06A; }
.page.theme-dark .invite-btn-text {
  color: var(--color-primary);
}
/* ====== 会员升级入口 V3.2 ====== */
.vip-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx;
}
.vip-entry-left {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.vip-entry-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary, #1A1A1A);
}
.vip-entry-desc {
  font-size: 24rpx;
  color: var(--text-secondary, #999999);
}
.vip-entry-badge {
  font-size: 24rpx;
  color: #ED6A0C;
  font-weight: 600;
  margin-right: 8rpx;
}
.vip-entry:active { opacity: 0.85; }
/* 「填写邀请码」入口：原为绿色小字，几乎看不见 → 改为带描边的胶囊按钮 */
.invite-input-link {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 68rpx;
  padding: 0 32rpx;
  border-radius: 999rpx;
  border: 2rpx solid rgba(58, 224, 124, 0.7);
  background: rgba(44, 208, 106, 0.18);
}
.invite-input-link-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #3AE07C;
  line-height: 1.4;
}


/* ===== 个人资料 ===== */
.profile-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx var(--sp-lg);
  margin-bottom: var(--sp-md);
  border-radius: 20rpx;
  background: var(--bg-card);
  border: 1rpx solid var(--border-color);
}
.profile-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #2CD06A 0%, #1FA855 100%);
  flex-shrink: 0;
}
.profile-avatar-img { width: 100%; height: 100%; }
.profile-avatar-text {
  font-size: 36rpx;
  font-weight: 600;
  color: #FFFFFF;
}
.profile-info { flex: 1; display: flex; flex-direction: column; gap: 6rpx; }
.profile-name { font-size: var(--fs-md); color: var(--text-primary); font-weight: 600; }
.profile-sub { font-size: var(--fs-xs); color: var(--text-secondary); }

/* 遮罩：铺满整屏，压住页面内容 */



/* 最近备份记录 */
.backup-record {
  padding: 12rpx var(--sp-lg) 16rpx;
}
.backup-record-text {
  font-size: var(--fs-xs);
  color: var(--text-secondary);
  line-height: 1.5;
  word-break: break-all;
}


/* 独立分组标题（开发者 / 数据与隐私）：原来 .group/.group-title 无样式，文字是默认暗色看不清 */
.section-group-title {
  padding: 26rpx var(--sp-md) 10rpx;
  font-size: var(--fs-sm);
  font-weight: 600;
  color: var(--text-secondary);
  letter-spacing: 1rpx;
}
.section-group {
  padding-bottom: 12rpx;
}
.privacy-hint {
  padding: 8rpx var(--sp-md) 20rpx;
}
.privacy-hint-text {
  font-size: var(--fs-xs);
  line-height: 1.6;
  color: var(--text-muted);
}


/* 邀请码「复制」按钮容器 */
.invite-copy {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 88rpx;
  min-height: 48rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: rgba(44, 208, 106, 0.14);
  border: 1rpx solid rgba(44, 208, 106, 0.5);
}


/* ===== 邀请卡（重构版）===== */
.invite-card {
  margin-bottom: var(--sp-md);
  border-radius: 24rpx;
  background: var(--bg-card);
  border: 1rpx solid var(--border-color);
  box-shadow: var(--shadow-card);
  overflow: hidden;
}

/* 顶部渐变区 */
.invite-hero {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 32rpx 28rpx;
  background: linear-gradient(135deg, rgba(44, 208, 106, 0.22) 0%, rgba(6, 168, 85, 0.08) 100%);
  border-bottom: 1rpx solid var(--border-color);
}
.invite-hero-badge {
  width: 84rpx;
  height: 84rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #2CD06A 0%, #06A855 100%);
  box-shadow: 0 4rpx 16rpx rgba(44, 208, 106, 0.35);
  flex-shrink: 0;
}
.invite-hero-badge-text {
  font-size: 34rpx;
  font-weight: 700;
  color: #FFFFFF;
}
.invite-hero-text {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  flex: 1;
  min-width: 0;
}
.invite-hero-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  line-height: 1.35;
}
.invite-hero-sub {
  font-size: 22rpx;
  color: var(--text-secondary);
  line-height: 1.4;
}

/* 邀请码票券 */
.invite-ticket {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 24rpx 28rpx 0;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  border: 2rpx dashed rgba(44, 208, 106, 0.55);
  background: rgba(44, 208, 106, 0.07);
}
.invite-ticket-label {
  font-size: 22rpx;
  color: var(--text-secondary);
  flex-shrink: 0;
}
.invite-ticket-code {
  flex: 1;
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 6rpx;
  color: #3AE07C;
  font-family: "SF Mono", Menlo, Consolas, monospace;
}
.invite-ticket-copy {
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  background: #2CD06A;
  flex-shrink: 0;
}
.invite-ticket-copy-text {
  font-size: 24rpx;
  font-weight: 600;
  color: #FFFFFF;
}

/* 进度 */
.invite-progress {
  padding: 24rpx 28rpx 0;
}
.invite-progress-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 12rpx;
}
.invite-progress-label {
  font-size: 24rpx;
  color: var(--text-secondary);
}
.invite-progress-value {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
}
.invite-progress-total {
  font-size: 22rpx;
  font-weight: 400;
  color: var(--text-muted, #808080);
}
.invite-progress-track {
  height: 12rpx;
  border-radius: 999rpx;
  background: var(--bg-input);
  overflow: hidden;
}
.invite-progress-bar {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #2CD06A 0%, #7BF0A8 100%);
  transition: width 400ms ease;
}

/* 双按钮 */
.invite-actions {
  display: flex;
  gap: 20rpx;
  padding: 28rpx;
}
.invite-action-primary {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  padding: 0;
  margin: 0;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #2CD06A 0%, #06A855 100%);
  border: none;
}
.invite-action-primary::after { border: none; }
.invite-action-primary-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #FFFFFF;
}
.invite-action-ghost {
  flex: 1;
  height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  border: 2rpx solid rgba(44, 208, 106, 0.5);
}
.invite-action-ghost-text {
  font-size: 28rpx;
  font-weight: 500;
  color: #2CD06A;
}

/* ===== 取件链接弹窗（品牌自定义样式）===== */
.pickup-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 9998;
  background: rgba(0, 0, 0, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}
.pickup-card {
  width: 100%;
  max-width: 620rpx;
  background: #ffffff;
  border-radius: 28rpx;
  padding: 44rpx 40rpx 32rpx;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.25);
}
.pickup-brand { display: flex; align-items: center; gap: 16rpx; margin-bottom: 24rpx; }
.pickup-brand-icon {
  width: 12rpx; height: 56rpx; border-radius: 6rpx;
  background: linear-gradient(180deg, #1ed07a 0%, #0ea55c 100%);
  flex-shrink: 0;
}
.pickup-brand-name { font-size: 32rpx; font-weight: 600; color: #14261c; }
.pickup-filename {
  font-size: 24rpx; color: #5a6b61;
  background: #f2f6f3; border-radius: 10rpx;
  padding: 12rpx 18rpx; margin-bottom: 20rpx;
  word-break: break-all;
}
.pickup-link-box {
  background: rgba(23, 194, 111, 0.08);
  border: 1rpx solid rgba(23, 194, 111, 0.25);
  border-radius: 14rpx;
  padding: 18rpx 20rpx;
  margin-bottom: 24rpx;
}
.pickup-link-text {
  font-size: 24rpx; color: #0e8a4f;
  word-break: break-all; line-height: 1.6;
  user-select: text;
}
.pickup-steps { margin-bottom: 30rpx; }
.pickup-step {
  display: flex; align-items: flex-start; gap: 14rpx;
  font-size: 24rpx; color: #5a6b61; line-height: 1.6;
  margin-bottom: 12rpx;
}
.pickup-step-num {
  flex-shrink: 0;
  width: 34rpx; height: 34rpx; border-radius: 50%;
  background: rgba(23, 194, 111, 0.12); color: #0e8a4f;
  font-size: 20rpx; font-weight: 600;
  display: flex; align-items: center; justify-content: center;
  margin-top: 2rpx;
}
.pickup-copy-btn {
  display: flex; align-items: center; justify-content: center;
  width: 100%;
  background: linear-gradient(135deg, #1ed07a 0%, #0ea55c 100%);
  color: #ffffff; font-size: 30rpx; font-weight: 600;
  border-radius: 16rpx; height: 92rpx;
  box-shadow: 0 10rpx 28rpx rgba(23, 194, 111, 0.35);
  margin-bottom: 18rpx;
  text-align: center;
}
.pickup-copy-btn::after { border: none; }
.pickup-copy-btn-hover { opacity: 0.85; transform: scale(0.98); }
.pickup-close {
  display: flex; align-items: center; justify-content: center;
  height: 84rpx;
  border-radius: 16rpx;
  border: 1rpx solid rgba(127, 127, 127, 0.28);
  font-size: 28rpx;
  color: var(--text-secondary, #5a6b61);
  background: transparent;
}
.pickup-expire {
  text-align: center; font-size: 22rpx; color: #b3c2ba;
  padding-top: 12rpx;
}

/* ===== 分组标题（设置页重排）===== */
.section-title {
  padding: 36rpx 12rpx 14rpx;
  font-size: 24rpx;
  color: var(--text-muted);
  letter-spacing: 1rpx;
}

/* ===== 安全说明卡（显眼入口 → 产品介绍）===== */
.trust-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 24rpx;
  padding: 26rpx 24rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, rgba(23, 194, 111, 0.12) 0%, rgba(23, 194, 111, 0.05) 100%);
  border: 1rpx solid rgba(23, 194, 111, 0.22);
}
.trust-card-mark {
  flex-shrink: 0;
  width: 8rpx;
  height: 52rpx;
  border-radius: 4rpx;
  background: linear-gradient(180deg, #1ed07a 0%, #0ea55c 100%);
}
.trust-card-body { flex: 1; }
.trust-card-title {
  font-size: 29rpx;
  font-weight: 600;
  color: #0e8a4f;
  letter-spacing: 0.5rpx;
}
.trust-card-sub {
  margin-top: 6rpx;
  font-size: 23rpx;
  color: var(--text-muted);
}
.trust-card-arrow { opacity: 0.55; }

.pickup-label {
  font-size: 23rpx;
  color: var(--text-muted, #97a8a0);
  margin: 4rpx 0 10rpx;
  letter-spacing: 0.5rpx;
}

/* ===== 邀请卡（紧凑版 2026-10-24）===== */
.invite-card-compact {
  margin-top: 20rpx;
  padding: 26rpx 26rpx 20rpx;
  border-radius: 18rpx;
  background: var(--bg-card, #ffffff);
  border: 1rpx solid rgba(127, 127, 127, 0.14);
}
.invite-row-main {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.invite-code-block { display: flex; align-items: baseline; gap: 14rpx; }
.invite-code-label { font-size: 22rpx; color: var(--text-muted, #97a8a0); }
.invite-code-value {
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  color: var(--text-primary, #1a1a1a);
}
.invite-copy-pill {
  font-size: 23rpx;
  color: #0e8a4f;
  padding: 8rpx 24rpx;
  border-radius: 100rpx;
  border: 1rpx solid rgba(23, 194, 111, 0.35);
}
.invite-hint {
  margin-top: 12rpx;
  font-size: 23rpx;
  color: var(--text-muted, #97a8a0);
}
.invite-hint-accent { color: #0e8a4f; font-weight: 600; }
.invite-row-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(127, 127, 127, 0.1);
}
.invite-count { font-size: 22rpx; color: var(--text-muted, #97a8a0); }
.invite-foot-actions { display: flex; align-items: center; gap: 30rpx; }
.invite-share {
  margin: 0;
  padding: 0;
  line-height: 1.6;
  font-size: 23rpx;
  font-weight: 600;
  color: #0e8a4f;
  background: transparent;
  border: none;
}
.invite-share::after { border: none; }
.invite-enter { font-size: 23rpx; color: var(--text-muted, #97a8a0); }

/* 「必读」标签与未读红点 */
.trust-badge {
  display: inline-block;
  margin-left: 12rpx;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
  font-size: 20rpx;
  font-weight: 500;
  color: #c73e33;
  background: rgba(199, 62, 51, 0.1);
  vertical-align: middle;
}
.trust-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #e64340;
  margin-right: 6rpx;
  flex-shrink: 0;
}

/* 邀请卡片离屏画布（绘制用，不可见） */
.invite-canvas {
  position: fixed;
  left: -9999px;
  top: 0;
  width: 768px;
  height: 1365px;
  pointer-events: none;
}
.invite-card-link { font-size: 23rpx; color: #0e8a4f; font-weight: 600; }

/* 填写邀请码：虚线框入口 */
.invite-enter-box {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 18rpx;
  padding: 20rpx 24rpx;
  border: 1rpx dashed rgba(23, 194, 111, 0.5);
  border-radius: 12rpx;
  background: rgba(23, 194, 111, 0.04);
}
.invite-enter-text {
  font-size: 24rpx;
  color: #0e8a4f;
}
.invite-enter-arrow {
  font-size: 28rpx;
  color: rgba(14, 138, 79, 0.65);
}

.container { position: relative; z-index: 1; }
