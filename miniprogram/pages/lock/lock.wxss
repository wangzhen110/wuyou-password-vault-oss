@import '../../styles/theme.wxss';

.page {
  background: var(--bg-page);
  height: 100vh;          /* 固定视口高度：锁屏页禁止滚动（2026-10-23 用户要求） */
  overflow: hidden;
  position: relative;
  display: flex;
  flex-direction: column;
}

/* 版本号：绝对定位固定底部，不参与文档流/滚动 */
.lock-version-text {
  position: absolute;
  bottom: 20rpx;
  left: 0;
  right: 0;
  text-align: center;
  font-size: 22rpx;
  color: var(--text-muted);
  opacity: 0.7;
}

/* 版本强制更新遮罩 */
.force-update-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 9999;
  background: var(--bg-page);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 60rpx;
}
.force-update-title { font-size: 40rpx; font-weight: 600; color: var(--text-primary); margin-bottom: 20rpx; }
.force-update-desc { font-size: 28rpx; color: var(--text-secondary); text-align: center; line-height: 1.6; margin-bottom: 60rpx; white-space: pre-line; }
.force-update-btn {
  width: 100%;
  background: var(--brand, #10b981);
  color: #ffffff;
  font-size: 32rpx;
  border-radius: 16rpx;
  padding: 24rpx 0;
  margin-bottom: 24rpx;
}
.force-update-tip { font-size: 22rpx; color: var(--text-muted); text-align: center; }
