@import '../../styles/theme.wxss';

.page {
  min-height: 100vh;
  background: var(--bg-page);
  box-sizing: border-box;
}

/* ====== Tab ====== */
/* 自定义导航栏已占住状态栏与标题位，tab 从导航栏下沿开始即可 */
.tab-bar {
  display: flex;
  background: var(--bg-card);
  border-bottom: 1rpx solid var(--border-color);
  position: sticky;
  top: 0;
  z-index: 10;
}
.tab-item {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: var(--text-secondary);
  position: relative;
}
.tab-item.active {
  color: var(--color-primary);
  font-weight: 600;
}
.tab-item.active::after {
  content: '';
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  bottom: 0;
  width: 48rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: var(--color-primary);
}

/* ====== 内容 ====== */
.content {
  padding: 30rpx;
  padding-bottom: calc(60rpx + env(safe-area-inset-bottom));
}
.section { margin-bottom: 36rpx; }
.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 14rpx;
}
.section-p {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.8;
  margin-bottom: 10rpx;
}
.update-time {
  margin-top: 20rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--text-secondary);
  opacity: 0.7;
}

.safe-area-bottom { height: env(safe-area-inset-bottom); }
