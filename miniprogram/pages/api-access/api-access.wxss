.page { min-height: 100vh; background: var(--bg-page, #121212); padding: 0 24rpx; }
.card {
  background: var(--bg-card, #1E1E1E);
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  margin-top: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}
.intro-title { font-size: 30rpx; font-weight: 600; color: var(--text-primary, #E8E8E8); }
.intro-desc { font-size: 24rpx; line-height: 1.7; color: var(--text-secondary, #B0B0B0); }
.section-title { font-size: 28rpx; font-weight: 600; color: var(--text-primary, #E8E8E8); }
.hint { font-size: 24rpx; color: var(--text-muted, #808080); line-height: 1.6; }
.code-box { display: flex; flex-direction: column; align-items: center; gap: 8rpx; padding: 16rpx 0; }
.code-text { font-size: 72rpx; font-weight: 700; letter-spacing: 16rpx; color: var(--color-primary, #2CD06A); }
.code-tip { font-size: 22rpx; color: var(--text-muted, #808080); }
.primary-btn {
  margin-top: 8rpx; height: 88rpx; display: flex; align-items: center; justify-content: center;
  background: var(--color-primary, #2CD06A); color: #fff; font-size: 30rpx; font-weight: 600;
  border-radius: 16rpx; padding: 0;
}
.primary-btn::after { border: none; }
.primary-btn.small { flex: 1; height: 80rpx; font-size: 28rpx; margin: 0; }
.ghost-btn {
  flex: 1; height: 80rpx; display: flex; align-items: center; justify-content: center;
  background: var(--bg-page, #121212); color: var(--text-primary, #E8E8E8);
  border: 1rpx solid var(--border-color, #333333); border-radius: 16rpx; font-size: 28rpx; padding: 0;
  text-align: center;
}
.ghost-btn::after { border: none; }
.ghost-btn.full { width: 100%; margin-top: 8rpx; box-sizing: border-box; }
.status-line { display: flex; align-items: center; gap: 10rpx; font-size: 24rpx; color: var(--text-secondary, #B0B0B0); }
.dot-waiting {
  width: 14rpx; height: 14rpx; border-radius: 50%;
  background: var(--color-warning, #F08C38); animation: pulse 1.2s infinite;
}
@keyframes pulse { 0%,100% { opacity: 1 } 50% { opacity: .3 } }
.pending-box {
  display: flex; flex-direction: column; gap: 10rpx;
  background: var(--color-primary-light, #0D3D26); border-radius: 16rpx; padding: 20rpx;
}
.pending-title { font-size: 26rpx; font-weight: 600; color: var(--text-primary, #E8E8E8); }
.pending-device { font-size: 30rpx; font-weight: 600; color: var(--color-primary, #2CD06A); }
.pending-warn { font-size: 22rpx; color: var(--color-warning, #F08C38); }
.pending-actions { display: flex; gap: 16rpx; margin-top: 8rpx; }
.result-line { font-size: 26rpx; }
.ok { color: var(--color-success, #2CD06A); }
.bad { color: var(--color-danger, #F06058); }
.empty { padding: 20rpx 0; }
.device-item {
  display: flex; align-items: center; gap: 16rpx;
  padding: 18rpx 0; border-bottom: 1rpx solid var(--border-color, #333333);
}
.device-item:last-child { border-bottom: none; }
.device-main { flex: 1; display: flex; flex-direction: column; gap: 6rpx; }
.device-name { font-size: 28rpx; color: var(--text-primary, #E8E8E8); font-weight: 600; }
.device-meta { font-size: 22rpx; color: var(--text-muted, #808080); }
.revoke-btn {
  height: 60rpx; line-height: 60rpx; padding: 0 24rpx; font-size: 24rpx;
  color: var(--color-danger, #F06058); background: transparent;
  border: 1rpx solid var(--color-danger, #F06058); border-radius: 999rpx;
}
.revoke-btn::after { border: none; }
.tip-card .code-snippet {
  background: var(--bg-page, #121212); border-radius: 12rpx; padding: 18rpx;
  font-family: monospace; font-size: 22rpx; line-height: 1.9;
  color: var(--text-secondary, #B0B0B0); display: flex; flex-direction: column;
}
.code-snippet .dim { color: var(--color-primary, #2CD06A); }
.safe-area-bottom { height: env(safe-area-inset-bottom); }


/* 会员门槛卡片 */
.vip-gate {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  padding: 48rpx 32rpx;
  text-align: center;
}


/* 说明卡片容器（此前只定义了 intro-title / intro-desc，块级样式缺失） */
.intro {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding: 28rpx var(--sp-md);
}

/* 一次性读取请求 */
.otp-card .otp-item {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--border-color);
}
.otp-card .otp-item:last-child { border-bottom: none; }
.otp-client { font-size: 28rpx; font-weight: 600; color: var(--text-primary); }
.otp-purpose { font-size: 24rpx; color: var(--text-secondary); }
.otp-entry { font-size: 24rpx; color: var(--text-muted); }
.otp-actions { display: flex; gap: 16rpx; margin-top: 12rpx; }
.otp-btn {
  flex: 1;
  font-size: 26rpx;
  border-radius: 12rpx;
  padding: 8rpx 0;
  line-height: 1.6;
}
.otp-deny { background: var(--bg-input); color: var(--text-secondary); }
.otp-allow { background: #2CD06A; color: #fff; }

.otp-empty { padding: 12rpx 0 4rpx; }
.otp-empty-text { font-size: 24rpx; color: var(--text-muted); }
.ghost-btn-hover {
  background: var(--bg-card, #1E1E1E);
  opacity: 0.85;
}

/* 文档地址展示（可长按选中） */
.doc-url-box {
  margin: 16rpx 0 10rpx;
  padding: 20rpx;
  background: var(--bg-page, #121212);
  border: 1rpx solid var(--border-color, #333333);
  border-radius: 12rpx;
}
.doc-url {
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--color-primary, #2CD06A);
  word-break: break-all;
}
.doc-url-hint {
  display: block;
  margin-bottom: 18rpx;
  font-size: 22rpx;
  color: var(--text-secondary, #B0B0B0);
}

/* ===== 文档链接弹窗（自定义，替代 showModal）===== */
.doc-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 9998;
  background: rgba(0, 0, 0, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}
.doc-card {
  width: 100%;
  max-width: 620rpx;
  background: #ffffff;
  border-radius: 28rpx;
  padding: 44rpx 40rpx 32rpx;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.25);
}
.doc-brand { display: flex; align-items: center; gap: 16rpx; margin-bottom: 18rpx; }
.doc-brand-icon {
  width: 12rpx; height: 56rpx; border-radius: 6rpx;
  background: linear-gradient(180deg, #1ed07a 0%, #0ea55c 100%);
  flex-shrink: 0;
}
.doc-brand-name { font-size: 32rpx; font-weight: 600; color: #14261c; }
.doc-desc { font-size: 24rpx; color: #5a6b61; line-height: 1.6; margin-bottom: 24rpx; }
.doc-label { font-size: 22rpx; color: #97a8a0; margin-bottom: 10rpx; }
.doc-link-box {
  background: rgba(23, 194, 111, 0.08);
  border: 1rpx solid rgba(23, 194, 111, 0.25);
  border-radius: 14rpx;
  padding: 18rpx 20rpx;
  margin-bottom: 28rpx;
}
.doc-link-text {
  font-size: 24rpx; color: #0e8a4f;
  word-break: break-all; line-height: 1.6;
  user-select: text;
}
.doc-copy-btn {
  display: flex; align-items: center; justify-content: center;
  width: 100%;
  background: linear-gradient(135deg, #1ed07a 0%, #0ea55c 100%);
  color: #ffffff; font-size: 30rpx; font-weight: 600;
  border-radius: 16rpx; height: 92rpx;
  box-shadow: 0 10rpx 28rpx rgba(23, 194, 111, 0.35);
  margin-bottom: 18rpx;
}
.doc-close {
  display: flex; align-items: center; justify-content: center;
  height: 84rpx;
  border-radius: 16rpx;
  border: 1rpx solid rgba(127, 127, 127, 0.28);
  font-size: 28rpx;
  color: #5a6b61;
}
.doc-btn-hover { opacity: 0.86; }
