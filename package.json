{
  "name": "cloud-password-vault",
  "version": "4.3.15",
  "description": "云端密码储存管家 - 安全密码管理微信小程序",
  "main": "miniprogram/app.js",
  "scripts": {
    "test": "node --test",
    "backup:release": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File ./scripts/backup-release.ps1",
    "backup:push": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File ./scripts/backup-push.ps1",
    "test:backup-release": "node --test tests/backup-release.test.js tests/miniprogram-release.test.js",
    "test:release": "node --test tests/miniprogram-release.test.js tests/release-manifest.test.js",
    "build:miniprogram-release": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File ./scripts/build-miniprogram-release.ps1",
    "deploy:function": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File ./scripts/deploy-function.ps1",
    "lint": "eslint miniprogram cloudfunctions tests --ext .js --max-warnings 30",
    "test:gate": "npm run lint && npm run ui:lint && npm run security:scan && npm run guard && npm run test:coverage",
    "guard": "node scripts/guard.js",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-lines=66 --test-coverage-functions=54 --test-coverage-branches=68",
    "security:scan": "node scripts/security-scan.js",
    "audit:security": "echo 对 agent 说「对本项目做一次安全审计」以触发完整流程；产物在 ~/security-audit-skill/",
    "ui:lint": "node scripts/ui-lint.js",
    "admin:serve": "node scripts/admin-serve.js"
  },
  "author": "WorkBuddy & Codex",
  "devDependencies": {
    "@noble/curves": "^1.9.7",
    "c8": "^12.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "prettier": "^3.9.10"
  }
}
